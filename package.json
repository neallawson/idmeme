{
  "name": "idmeme-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "test": "npm --workspace=src/backend run test",
    "check": "tsc -p src/backend/tsconfig.json --noEmit && npm --workspace=src/frontend run check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "eslint": "^9.1.0",
    "husky": "^8.0.3",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "vite": "^7.0.4",
    "svelte": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0"
  }
}
