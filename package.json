{
  "name": "idmeme-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspaces",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "test": "npm run test --workspaces"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "eslint": "^9.1.0",
    "prettier": "^3.2.5",
    "husky": "^8.0.3"
  }
}
